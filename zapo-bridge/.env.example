# Copie para .env só se precisar mudar algo. WAHA_API_KEY e WAHA_SESSION
# vêm do .env do projeto (pasta acima), o mesmo que o Python usa.

# 4443 e 4444 ficam presas pelo Docker Desktop. WAHA_URL do .env do projeto aponta para esta porta.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=4450

# Para onde vão votos de enquete e comandos (!enquete) recebidos nos grupos.
BRIDGE_WEBHOOK_URL=http://127.0.0.1:8787/whatsapp/webhook

# Credenciais do aparelho pareado. Não apague: apagar obriga a parear de novo.
BRIDGE_DB_PATH=data/zapo.sqlite

# Como o aparelho aparece em "Aparelhos conectados": chrome, firefox, safari, edge, opera.
BRIDGE_DEVICE_BROWSER=chrome

# trace, debug, info, warn, error
BRIDGE_LOG_LEVEL=info
