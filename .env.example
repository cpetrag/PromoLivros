# Copie este arquivo para .env e preencha. Nunca commite o .env.

# Chave privada da API Keepa (https://keepa.com/#!api)
KEEPA_API_KEY=

# Tag de afiliado da Amazon (Associates), por exemplo meunome-20
AMAZON_AFFILIATE_TAG=

# Chave da OpenAI, usada só para a frase de uma linha sobre o livro
OPENAI_API_KEY=

# WAHA só do Promo Livros, na porta 4443 do Mac. O painel é https://esteira.promolivros.org/dashboard
WAHA_URL=http://127.0.0.1:4443
WAHA_API_KEY=
WAHA_SESSION=promo-livros
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# Login da dashboard em 127.0.0.1:8787. Distinto do login do painel WAHA.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# API local de links de afiliado no Mac Mini. O mesmo AMZ_TOKEN de amz-link-api/.env.
# Sem o token, os links continuam no formato amazon.com.br/dp/ASIN?tag=
AMZ_TOKEN=
AMZ_LINK_API_URL=http://127.0.0.1:3070
